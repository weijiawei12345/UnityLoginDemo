# Firebase desktop native libs for non-Windows platforms.
# GitHub rejects files >100MB; macOS .bundle (FirebaseCppApp) exceeds the limit.
# Windows interview/demo builds only need the .dll under Plugins/x86_64.
Assets/Firebase/Plugins/x86_64/*.bundle
Assets/Firebase/Plugins/x86_64/*.bundle.meta
Assets/Firebase/Plugins/x86_64/*.so
Assets/Firebase/Plugins/x86_64/*.so.meta

# Optional: keep local only unless you target these platforms in the repo.
Assets/Plugins/iOS/Firebase/
Assets/Plugins/tvOS/Firebase/
